# AI providers. Local development defaults to Ollama; production uses OpenAI-compatible endpoints.
AI_PROVIDER=ollama
AI_BASE_URL=
AI_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=180
LLM_KEEP_ALIVE=30m          # how long Ollama keeps the chat model loaded after a question

# Local storage defaults (SQLite + local PDFs; no PostgreSQL required)
DATABASE_URL=
DATABASE_PATH=./data/app.db
VECTOR_DIMENSIONS=768
# PostgreSQL only: DocMind uses its own isolated `docmind` schema; public/auth/storage schemas are untouched.
# The connection search_path is fixed to docmind,extensions,public.
# The app pool defaults to 1..5 connections, 15 second checkout timeout.
DATABASE_POOL_MAX=5
DATABASE_POOL_TIMEOUT=15
# PostgreSQL only. verify-full is the secure default; never disable certificate checking in production.
DATABASE_SSLMODE=verify-full
# Optional path to the CA bundle supplied by your PostgreSQL provider.
DATABASE_SSLROOTCERT=
UPLOAD_DIR=./data/uploads
UPLOAD_STORAGE=local

# Production: set DATABASE_URL to PostgreSQL with pgvector enabled, and use OpenAI-compatible AI providers.
# Example: postgresql://user:password@host:5432/docmind?sslmode=require
# For durable hosted PDFs choose S3-compatible storage, or mount UPLOAD_DIR on a persistent disk.
# Production S3-compatible storage (set UPLOAD_STORAGE=s3). Supabase S3 endpoint example:
# https://<project-ref>.supabase.co/storage/v1/s3
# Use the S3 credentials from Supabase Storage settings, not the database password.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Uploads
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.20
MAX_HISTORY_MESSAGES=10
MAX_CONTEXT_CHARS=8000

# App
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Authentication (development uses console email links in server logs)
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:8000
SESSION_EXPIRE_MINUTES=10080
EMAIL_PROVIDER=console
EMAIL_FROM=DocMind <noreply@example.com>
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30
# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# SMTP alternative (when EMAIL_PROVIDER=smtp)
# Gmail: smtp.gmail.com:587, SMTP_STARTTLS=true; use a Google App Password, not your regular password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
